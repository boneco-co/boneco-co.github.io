+    const r2=document.createElement('div'); r2.className='hz-r2'; [row('h-risktype'),row('h-action')].forEach(x=>x&&r2.appendChild(x));
+    const two=$('h-level').closest('.form-2col'), lvBox=$('h-level').parentElement, noteBox=$('h-note').parentElement;
+    const left=document.createElement('div'); left.className='hz-left'; left.appendChild(lvBox); left.appendChild(noteBox); if(two) two.remove();
+    c2.appendChild(r2);
+    const right=document.createElement('div'); while(c3.firstChild) right.appendChild(c3.firstChild);
+    const r3=document.createElement('div'); r3.className='hz-r3'; r3.appendChild(left); r3.appendChild(right); c3.appendChild(r3);
+    const sel=$('h-level'); sel.style.display='none';
+    const lv=document.createElement('div'); lv.className='hz-lv'; lv.innerHTML='<button type="button" data-v="High">🔴 높음</button><button type="button" data-v="Medium">🟠 보통</button><button type="button" data-v="Low">🟢 낮음</button>';
