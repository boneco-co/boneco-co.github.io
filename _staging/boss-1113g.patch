-  const f=$('form-minwon'), b=$('mj-b'); if(f&&f.parentElement!==b) b.appendChild(f);
+  const f=$('form-minwon'), b=$('mj-b'); if(f&&f.parentElement!==b){ b.appendChild(f); mjLayout(f); }
   try{ resetMForm(); }catch(e){}
   $('mj-bg').classList.add('on'); b.scrollTop=0; setTimeout(()=>{ const a=$('m-addr'); if(a) a.focus(); },50);
 }
+// [11_13] 접수창 배치 (시안): 위 두 칸 높이 맞춤(관리대상 → 오른쪽 칸), 주소 줄 가로 전체, 사진 칸 옆은 내용 구분·세부 내용, 방문 확인결과·처리 상태는 아래 가로 전체
+function mjLayout(f){
+  try{
+    const cards=[...f.querySelectorAll(':scope>.form-card')]; if(cards.length<4) return;
+    const [c1,c2,c3,c4]=cards, row=id=>$(id)&&$(id).closest('.form-row');
+    const addrRow=row('m-addr'), mg=$('m-mgmt').parentElement, st=$('m-status').parentElement, act=row('m-action'), two=st.parentElement;
+    const addrCard=document.createElement('div'); addrCard.className='form-card mj-full'; addrCard.appendChild(addrRow);
+    mg.classList.add('form-row'); c2.appendChild(mg);
+    const actCard=document.createElement('div'); actCard.className='form-card mj-full'; actCard.appendChild(act);
+    st.classList.add('mj-half'); actCard.appendChild(st); if(two&&!two.children.length) two.remove();
+    c2.after(addrCard); c4.after(actCard);
+    const ct=$('m-content'); if(ct) ct.style.minHeight='118px';
+  }catch(e){}
+}
 function mjClose(){ $('mj-bg').classList.remove('on'); const m=$('mj'); if(m){ m.style.left=''; m.style.top=''; } }   // 닫으면 자리는 처음으로 (크기는 그대로)
 // [11_13] 담당 팀 자동 — 민원처리앱 규칙: 15시 이전(06시~) 접수 = 기동반, 15시 이후·새벽 = 민원종류별 야간 수거팀 (현장앱이 이 팀으로 받음)
 function mTeamAuto(){
