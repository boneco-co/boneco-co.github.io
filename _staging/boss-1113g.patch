@@ -1538,10 +1539,24 @@ function geoH(){
 })();
 // [11_13] 민원 접수창 — 창(이동·크기 조정)은 그대로, 안의 입력 양식은 부장님 원래 민원 등록 양식(#form-minwon)을 옮겨 와 쓴다
