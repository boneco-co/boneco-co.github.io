+(function lgWinDrag(){
+  let d=null;
+  document.addEventListener('mousedown',function(e){
+    if(window.innerWidth<=700||!e.target.closest) return;
+    const h=e.target.closest('#modal-hdr,#mj-h'); if(!h||e.target.closest('button,input,select,a,label')) return;
+    const box=h.id==='mj-h'?$('mj'):$('modal'); if(!box) return;
+    d={box,sx:e.clientX,sy:e.clientY,ox:parseFloat(box.style.left)||0,oy:parseFloat(box.style.top)||0}; box.style.position='relative'; e.preventDefault();
+  });
+  document.addEventListener('mousemove',function(e){ if(!d) return; d.box.style.left=(d.ox+e.clientX-d.sx)+'px'; d.box.style.top=(d.oy+e.clientY-d.sy)+'px'; });
+  document.addEventListener('mouseup',function(){ d=null; });
+})();
