+// [11_13] 사진대지 — 민원처리앱에서 가져온 방식: A4 세로 한 장에 민원 3건(왼쪽 처리 전 · 오른쪽 처리 후).
+//   지금 목록(검색·기간·분류·숫자 칸) 중 처리 전·후 사진이 있는 건만. 사진 아래: 접수번호 · 민원종류 · 주소 · 접수일 → 처리일 (민원인 이름·전화 없음)
+async function lgSheet(){
+  const list=lgFiltered().slice().sort((a,b)=>String((a.date||'')+(a.time||'')).localeCompare(String((b.date||'')+(b.time||''))));
+  if(!list.length){ toast('목록에 민원이 없습니다'); return; }
+  toast('📷 사진을 모으는 중… ('+list.length+'건)');
+  const rows=[];
+  for(const r of list){ try{ const v=(await PHOTOS.child(r.id).once('value')).val()||{}; const ex=v.extra?Object.values(v.extra):[];
+      const bf=v.before||v.hazard||ex[0]||'', af=v.after||ex[1]||''; if(bf||af) rows.push({r,bf,af}); }catch(e){} }
+  if(!rows.length){ toast('처리 전·후 사진이 있는 민원이 없습니다'); return; }
+  const w=window.open('','_blank'); if(!w){ toast('팝업이 막혀 있습니다 — 허용해 주세요'); return; }
+  const E=mkEsc, pr=lgPerRange(), rng=pr?(pr[0]+' ~ '+pr[1]):'전체 기간', pages=[];
+  for(let i=0;i<rows.length;i+=3) pages.push(rows.slice(i,i+3));
+  const cell=(src,lb)=>'<div class="ph">'+(src?'<img src="'+src+'">':'<div class="no">사진 없음</div>')+'<span>'+lb+'</span></div>';
+  const done=r=>String(r.doneAt||(r.status==='처리완료'?r.updatedAt:'')||'').slice(5,16);
+  w.document.write('<!doctype html><html><head><meta charset="utf-8"><title>민원 처리 사진대지</title><style>'
+    +'@page{size:A4 portrait;margin:12mm}body{font-family:"Malgun Gothic",sans-serif;margin:0;color:#000}'
+    +'.pg{page-break-after:always;display:grid;grid-template-rows:auto 1fr 1fr 1fr;gap:5mm;height:270mm}.pg:last-child{page-break-after:auto}'
+    +'h1{font-size:15px;text-align:center;margin:0}.meta{font-size:10px;text-align:right;margin-top:2px}'
+    +'.row{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr auto;gap:2mm 3mm;min-height:0}'
+    +'.ph{position:relative;border:1px solid #555;overflow:hidden;min-height:0}.ph img{width:100%;height:100%;object-fit:cover;display:block}'
+    +'.ph span{position:absolute;left:4px;top:4px;background:rgba(0,0,0,.65);color:#fff;font-size:10px;padding:1px 6px;border-radius:8px}'
+    +'.no{display:grid;place-items:center;height:100%;color:#888;font-size:11px}.cap{grid-column:1/3;font-size:10.5px;border-bottom:1px solid #999;padding-bottom:2px}'
+    +'</style></head><body>'
+    +pages.map((pg,pi)=>'<div class="pg"><div><h1>민원 처리 사진대지</h1><div class="meta">'+E(rng)+' · '+(pi+1)+'/'+pages.length+'쪽 · 출력 '+today()+'</div></div>'
+      +pg.map(x=>'<div class="row">'+cell(x.bf,'처리 전')+cell(x.af,'처리 후')+'<div class="cap">'+E(x.r.no||'')+' · '+E(x.r.subtype||'민원')+' · '+E(lgAddrOf(x.r))+' · 접수 '+E(String(x.r.date||'').slice(5))+' '+E(x.r.time||'')+(done(x.r)?' → 처리 '+E(done(x.r)):'')+'</div></div>').join('')
+      +'</div>').join('')
+    +'<script>setTimeout(function(){window.print();},600)<\/script></body></html>');
+  w.document.close();
+}
